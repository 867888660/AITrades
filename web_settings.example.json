{
  "wallet_addresses": [],
  "crypto_symbols": [
    "BTCUSDT",
    "ETHUSDT",
    "SOLUSDT"
  ],
  "finance_symbols": [
    "AAPL",
    "MSFT"
  ],
  "crypto_refresh_sec": 15,
  "finance_refresh_sec": 20,
  "ui_refresh_sec": 5,
  "sqlite_db_path": "Data/market_data.db",
  "order_list_db_path": "Data/PolyMarketOrderList.db",
  "strategy_monitoring_db_path": "Data/PolyMarketMonitoring.db",
  "market_realtime_db_path": "Data/polymarket_realtime.db",
  "polymarket_dictionary_db_path": "Data/PolyMarketDictionary.db",
  "strategy_metrics_db_dir": "strategy_metrics_dbs",
  "history_data_root": "",
  "history_data_source_roots": [],
  "strategy_monitoring_table": "strategy_registry",
  "include_crypto_fundamentals": true,
  "coingecko_api_key_header": "x-cg-demo-api-key",
  "openbb_settings": {
    "enabled": false,
    "base_url": "http://127.0.0.1:6901",
    "default_provider": "yfinance",
    "allowed_providers": ["yfinance"],
    "timeout_sec": 30
  },
  "data_source_settings": {
    "mode": "HYBRID",
    "version": 1,
    "priority_orders": {
      "EQUITY:1D:BARS": [
        "OPENBB:YFINANCE",
        "OPENBB:POLYGON",
        "OPENBB:TIINGO",
        "OPENBB:FMP",
        "OPENBB:INTRINIO"
      ],
      "EQUITY:SNAPSHOT:QUOTE": ["FINNHUB"],
      "CRYPTO_SPOT:*:BARS": ["BINANCE"],
      "CRYPTO:SNAPSHOT:SNAPSHOT": ["COINGECKO"],
      "POLYMARKET_BINARY:*:PRICE_HISTORY": ["POLYMARKET"],
      "MACRO:1D:SERIES": ["OPENBB:FRED"]
    }
  },
  "agent_policy": {
    "enabled": true,
    "permissions": {
      "research_read": true,
      "research_project_create": true,
      "research_autonomous_write": true,
      "research_run_execute": true
    },
    "event_graph_approval": {
      "mode": "manual",
      "auto_apply_actor_id": "event_graph_trusted_rule",
      "max_items_per_request": 100,
      "min_confidence": 0.0,
      "require_evidence_summary": false
    }
  },
  "llm_settings": {
    "enabled": false,
    "provider": "dashscope_openai_compatible",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "model": "qwen-plus",
    "temperature": 0.2,
    "max_tokens": 2048,
    "timeout_sec": 60
  }
}
